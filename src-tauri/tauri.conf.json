{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coinjura Widget",
  "version": "0.7.13",
  "identifier": "com.coinjura.widget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "코인주라 위젯",
        "width": 300,
        "height": 430,
        "minWidth": 260,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "toast",
        "url": "toast.html",
        "width": 300,
        "height": 38,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "coinjura",
    "copyright": "© 2026 coinjura",
    "homepage": "https://coinjura.com",
    "category": "Finance",
    "shortDescription": "코인주라 시세 위젯",
    "longDescription": "코인주라(coinjura.com)의 거래소별 암호화폐 시세와 김치 프리미엄을 바탕화면에 띄우는 위젯입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
